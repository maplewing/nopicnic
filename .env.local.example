# Stripe
# Developers → API keys in Stripe dashboard
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe webhook signing secret
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
# resend.com → API Keys
# Domain nopicnicpress.com must be verified in Resend before sending live.
RESEND_API_KEY=re_...

# Loops
# loops.so → Settings → API Key
LOOPS_API_KEY=...

# Shippo (live shipping rates)
# goshippo.com → API → API Keys → use "Live" token for production
# Rate lookups are free; you only pay when purchasing labels through Shippo.
SHIPPO_API_KEY=shippo_live_...

# Shippo also needs a payment method on file before it will serve the tracking
# endpoint — rate lookups are free, tracking is not gated behind a setting but
# behind billing. Without one the arrival email cron gets a 401 on every lookup,
# never sees a parcel as delivered, and sends nothing.
# Add a card at https://goshippo.com/user/billing/

# EasyPost (international UPS rates)
# easypost.com → API Keys → Production
EASYPOST_API_KEY=EZAK...

# NPP origin ZIP code (used for Shippo rate calculation)
NPP_ORIGIN_ZIP=94710

# Vercel Cron authentication — REQUIRED for the two daily cron jobs.
# Vercel does NOT create this for you. Add it in Vercel → Settings →
# Environment Variables, then redeploy. Vercel then sends it as
# "Authorization: Bearer <value>" on every cron request. Without it,
# /api/drip/arrival and /api/drip/review-request return 401 and no mail
# is ever sent, with no error anywhere obvious.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-long-random-secret-here

# Upstash Redis — sequential order numbers, and the review-email sent set.
# Vercel dashboard → Storage → Upstash → .env.local tab
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Stripe coupon used for the discount in the arrival email.
# Stripe dashboard → Products → Coupons → copy the coupon ID.
# Optional: leave blank and the arrival email goes out without a code.
STRIPE_ARRIVAL_COUPON_ID=

# Meta Pixel + Conversions API. Both optional — leave blank to run no ad
# tracking at all. Visitors in the EEA, UK and Switzerland are excluded
# regardless (see lib/region.js).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Admin stats start date, as a Unix timestamp. Optional — defaults to the
# last 60 days.
STATS_SINCE=

# Site URL (no trailing slash)
NEXT_PUBLIC_URL=https://nopicnicpress.com

# Digital download token secret (also used to sign review approval tokens)
# Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=your-long-random-secret-here

# GitHub — used to auto-commit approved reviews to data/products.js
# Create a fine-grained PAT at github.com/settings/personal-access-tokens/new
#   → Repository access: only this repo
#   → Permissions: Contents = Read and write
# GITHUB_REPO format: "username/repo-name"
GITHUB_TOKEN_NPP=github_pat_...
GITHUB_REPO=your-username/nopicnic
GITHUB_BRANCH=main

# Admin dashboard password
# Set to any strong password. Used to log in at /admin.
ADMIN_PASSWORD=your-admin-password-here

# Vercel Blob — required for private blob signed URLs
# Vercel dashboard → Storage → your blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Digital file URLs — base URL only, no query string
# Vercel dashboard → Storage → blob store → click file → copy URL (strip ?... query)
# Don't Call It That
DCIT_PDF_URL=
# Run Studio Run digital files
RSR_EPUB_URL=
RSR_PDF_URL=
